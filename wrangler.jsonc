{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shafile",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shafile"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shafile-db",
      "database_id": "66e17183-6f8b-48fb-88c6-c02116e9bf19",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB_BUCKET",
      "bucket_name": "shafile-blobs"
    }
  ],
  "vars": {
    "SHAFILE_RUNTIME": "cloudflare",
    "TRUST_PROXY": "true",
    "TELEGRAM_BOT_USERNAME": "shafiledev_bot",
    "TELEGRAM_MINI_APP_SHORT_NAME": "shafile"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
