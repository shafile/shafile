# 数据目录（SQLite、密文、开发环境自动生成的密钥）
SHAFILE_DATA_DIR=./data

# 可选：覆盖数据库与密文目录
# DATABASE_PATH=./data/shafile.db
# BLOB_DIR=./data/blobs

# 生产环境必须显式设置；不设置时会在 data/.secrets.json 自动生成
# TICKET_SECRET=base64url-32-bytes
# IP_HASH_SECRET=base64url-32-bytes

# Telegram Mini App 身份校验（P1a，可选）
# 不设置 TELEGRAM_BOT_TOKEN 时 /api/telegram/session 会返回 503
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SESSION_SECRET=base64url-32-bytes
# TELEGRAM_HASH_SECRET=base64url-32-bytes
# TELEGRAM_WEBHOOK_SECRET=base64url-32-bytes
# TELEGRAM_BOT_USERNAME=shafiledev_bot
# TELEGRAM_MINI_APP_SHORT_NAME=shafile

# 单文件与总存储上限（字节）
MAX_SHARE_BYTES=5368709120
MAX_STORAGE_BYTES=53687091200

# 位于反向代理之后时设为 true，才会信任 X-Forwarded-For
TRUST_PROXY=false

# Cloudflare Tunnel：从 Zero Trust → Networks → Tunnels 获取 token
# 仅 docker-compose.cloudflare.yml 使用
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Workers 清理任务鉴权（wrangler secret put CRON_SECRET）
CRON_SECRET=
