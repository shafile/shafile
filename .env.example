# 数据目录（SQLite、密文、开发环境自动生成的密钥）
SHAFILE_DATA_DIR=./data

# 可选：覆盖数据库与密文目录
# DATABASE_PATH=./data/shafile.db
# BLOB_DIR=./data/blobs

# 生产环境必须显式设置；不设置时会在 data/.secrets.json 自动生成
# TICKET_SECRET=base64url-32-bytes
# IP_HASH_SECRET=base64url-32-bytes

# 单文件与总存储上限（字节）
MAX_SHARE_BYTES=5368709120
MAX_STORAGE_BYTES=53687091200

# 位于反向代理之后时设为 true，才会信任 X-Forwarded-For
TRUST_PROXY=false
